{
  "name": "@praneethtss/bonfire",
  "version": "0.2.0",
  "description": "A local-first terminal coding assistant. Streams tokens, previews diffs, and runs against any local model via Ollama or llama.cpp.",
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "terminal",
    "tui",
    "ink",
    "ollama",
    "llama.cpp",
    "mcp",
    "local-first"
  ],
  "license": "MIT",
  "author": "Praneeth TSS",
  "repository": {
    "type": "git",
    "url": "https://github.com/Praneethtkonda/bonfire"
  },
  "homepage": "https://github.com/Praneethtkonda/bonfire#readme",
  "bugs": {
    "url": "https://github.com/Praneethtkonda/bonfire/issues"
  },
  "type": "module",
  "bin": {
    "bonfire": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bonfire.config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli/bin.tsx",
    "start": "tsx src/cli/bin.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.32",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "ai": "^7.0.66",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "ignore": "^7.0.6",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
